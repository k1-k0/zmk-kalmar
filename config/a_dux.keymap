#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define QT_MS 180
#define HMR_RPI_MS 175
#define HCMB_RPI_MS 150
#define VCMB_RPI_MS 50
#define VCMB_MS 35
#define HCMB_MS 25
#define TCMB_RPI_MS 50
#define TCMB_MS 25
#define LHYPER LA(LC(LS(LGUI)))
#define RHYPER RS(RC(RA(RGUI)))

#define MSHFT &mshft RSHFT 0

&lt {
    tapping-term-ms = <180>;
    quick-tap-ms = <160>;
};

&sk {
    release-after-ms = <900>;
    quick-release;
};

/ {
    behaviors {
        lpht: left_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <QT_MS>;
            require-prior-idle-ms = <HMR_RPI_MS>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
            hold-trigger-on-release;
        };

        rpht: right_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <QT_MS>;
            require-prior-idle-ms = <HMR_RPI_MS>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
            hold-trigger-on-release;
        };

        mshftm: magic_shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk RSHFT>, <&caps_word>;
            mods = <(MOD_RSFT)>;
        };

        mshft: magic_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&mshftm>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <HMR_RPI_MS>;
        };
    };

    app_swap: app_swapper {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;

        ignored-key-positions = <2 16 17 18 19>;
    };

    appw_swap: app_win_swapper {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LGUI>, <&kp GRAVE>, <&kt LGUI>;

        ignored-key-positions = <22 16 17 18 19>;
    };

    tbbr: tabber {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LCTRL>, <&kp TAB>, <&kt LCTRL>;

        ignored-key-positions = <6 16 17 18 19>;
    };

    combos {
        compatible = "zmk,combos";

        c_esc       { bindings = <&kp ESC>;       key-positions = <1 2>;   require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_grave     { bindings = <&kp GRAVE>;     key-positions = <2 3>;   require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_tab       { bindings = <&kp TAB>;       key-positions = <6 7>;   require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_caps      { bindings = <&kp CAPS>;      key-positions = <7 8>;   require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_bslh      { bindings = <&kp BSLH>;      key-positions = <11 12>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_equal     { bindings = <&kp EQUAL>;     key-positions = <11 13>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_lbkt      { bindings = <&kp LBKT>;      key-positions = <12 13>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_f14       { bindings = <&kp F14>;       key-positions = <12 30>; require-prior-idle-ms = <TCMB_RPI_MS>;  timeout-ms = <TCMB_MS>; };
        c_rbkt      { bindings = <&kp RBKT>;      key-positions = <16 17>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_minus     { bindings = <&kp MINUS>;     key-positions = <16 18>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_fslh      { bindings = <&kp FSLH>;      key-positions = <17 18>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_f15       { bindings = <&kp F15>;       key-positions = <17 33>; require-prior-idle-ms = <TCMB_RPI_MS>;  timeout-ms = <TCMB_MS>; };
        c_del       { bindings = <&kp DEL>;       key-positions = <21 22>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_lpar      { bindings = <&kp LPAR>;      key-positions = <22 23>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_f14e      { bindings = <&kp F14>;       key-positions = <21 23>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_rpar      { bindings = <&kp RPAR>;      key-positions = <26 27>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_bspc      { bindings = <&kp BSPC>;      key-positions = <27 28>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_f15e      { bindings = <&kp F15>;       key-positions = <26 28>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_lgame     { bindings = <&tog 5>;        key-positions = <20 24>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_rgame     { bindings = <&tog 5>;        key-positions = <25 29>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_lhyper    { bindings = <&sk LHYPER>;    key-positions = <12 14>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_rhyper    { bindings = <&sk RHYPER>;    key-positions = <15 17>; require-prior-idle-ms = <HCMB_RPI_MS>;  timeout-ms = <HCMB_MS>; };
        c_lhyper2   { bindings = <&sk LHYPER>;    key-positions = <12 23>; require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_rhyper2   { bindings = <&sk RHYPER>;    key-positions = <17 26>; require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };

        c_excl      { bindings = <&kp EXCL>;      key-positions = <1 11>;  require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_at        { bindings = <&kp AT>;        key-positions = <2 12>;  require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_hash      { bindings = <&kp HASH>;      key-positions = <3 13>;  require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_dllr      { bindings = <&kp DLLR>;      key-positions = <4 14>;  require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_prcnt     { bindings = <&kp PRCNT>;     key-positions = <5 15>;  require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_caret     { bindings = <&kp CARET>;     key-positions = <6 16>;  require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_amps      { bindings = <&kp AMPS>;      key-positions = <7 17>;  require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_star      { bindings = <&kp STAR>;      key-positions = <8 18>;  require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };

        c_cut       { bindings = <&kp LG(X)>;     key-positions = <11 21>; require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_copy      { bindings = <&kp LG(C)>;     key-positions = <12 22>; require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_paste     { bindings = <&kp LG(V)>;     key-positions = <13 23>; require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_undo      { bindings = <&kp LG(Z)>;     key-positions = <14 24>; require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
        c_redo      { bindings = <&kp LG(LS(Z))>; key-positions = <15 25>; require-prior-idle-ms = <VCMB_RPI_MS>;  timeout-ms = <VCMB_MS>; };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q         &kp W         &kp E          &kp R          &kp T                              &kp Y   &kp U          &kp I          &kp O         &kp P
&lpht LGUI A  &lpht LALT S  &lpht LCTRL D  &lpht LSHFT F  &kp G                              &kp H   &rpht RSHFT J  &rpht RCTRL K  &rpht RALT L  &rpht RGUI SEMI
&kp Z         &kp X         &kp C          &kp V          &kp B                              &kp N   &kp M          &kp COMMA      &kp DOT       &kp SQT
                                                          &lt 2 SPACE  &lt 3 ENTER    &sl 1  MSHFT
            >;
        };

        num {
            bindings = <
&trans         &kp N7             &kp N8          &kp N9          &trans                    &kp KP_NUMLOCK  &kp LPAR             &kp RPAR              &kp CARET               &kp ENTER
&lpht LCMD N0  &lpht LEFT_ALT N4  &lpht LCTRL N5  &lpht LSHFT N6  &trans                    &kp KP_EQUAL    &rpht RSHFT KP_PLUS  &rpht RCTRL KP_MINUS  &rpht RALT KP_MULTIPLY  &rpht RGUI KP_DIVIDE
&trans         &kp N1             &kp N2          &kp N3          &trans                    &trans          &trans               &kp KP_COMMA          &kp KP_DOT              &trans
                                                                  &trans  &trans    &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans    &kp ESC     &kp LS(TAB)    &app_swap   &kp CAPS                      &kp PG_UP     &kp LS(TAB)       &kp UP            &tbbr             &kp ENTER
&sk LGUI  &sk LALT    &sk LCTRL      &sk LSHFT   &caps_word                    &kp HOME      &rpht RSHFT LEFT  &rpht RCTRL DOWN  &rpht RALT RIGHT  &rpht RGUI END
&trans    &sk LHYPER  &kp LS(GRAVE)  &appw_swap  &trans                        &kp PG_DN     &kp BSPC          &kp TAB           &kp DEL           &kp K_APP
                                                 &trans      &trans    &trans  &kp K_CANCEL
            >;
        };

        fun {
            bindings = <
&kp F15           &kp F7         &kp F8          &kp F9          &kp F10                    &kp PAUSE_BREAK  &kp C_BRI_UP        &kp C_VOL_UP          &kp C_BRI_DN       &trans
&lpht LGUI PSCRN  &lpht LALT F4  &lpht LCTRL F5  &lpht LSHFT F6  &kp F11                    &kp INS          &rpht RSHFT C_PREV  &rpht RCTRL C_VOL_DN  &rpht RALT C_NEXT  &rpht RGUI PSCRN
&kp F14           &kp F1         &kp F2          &kp F3          &kp F12                    &key_repeat      &kp C_STOP          &kp C_MUTE            &kp C_PP           &trans
                                                                 &trans   &trans    &trans  &trans
            >;
        };

        ble {
            bindings = <
&bootloader     &sys_reset  &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1                    &bt BT_SEL 1  &bt BT_SEL 0  &out OUT_BLE  &sys_reset  &bootloader
&trans          &bt BT_CLR  &out OUT_TOG  &trans        &bt BT_SEL 2                    &bt BT_SEL 2  &trans        &out OUT_TOG  &bt BT_CLR  &trans
&bt BT_CLR_ALL  &trans      &out OUT_USB  &bt BT_SEL 4  &bt BT_SEL 3                    &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_USB  &trans      &bt BT_CLR_ALL
                                                        &trans        &trans    &trans  &trans
            >;
        };

        game {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T                               &kp Y     &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F  &kp G                               &kp H     &kp J  &kp K      &kp L    &kp SEMI
&kp Z  &kp X  &kp C  &kp V  &kp B                               &kp N     &kp M  &kp COMMA  &kp DOT  &kp FSLH
                            &kp SPACE  &kp ENTER    &kp ESCAPE  &kp BSPC
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        to_ble {
            if-layers = <3 1>;
            then-layer = <4>;
        };
    };
};
