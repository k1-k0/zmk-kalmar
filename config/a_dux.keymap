#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define RPI_MS 175
#define VCMB_MS 45
#define HCMB_MS 30

&lt {
    tapping-term-ms = <180>;
    quick-tap-ms = <160>;
};

&sk {
    release-after-ms = <900>;
    quick-release;
};

/ {
    behaviors {
        lpht: left_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <RPI_MS>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
            hold-trigger-on-release;
        };

        rpht: right_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <RPI_MS>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
            hold-trigger-on-release;
        };

        mshft: magic_shift {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sk RSHFT>, <&caps_word>;
        };
    };

    app_swap: app_swapper {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;

        ignored-key-positions = <2 16 17 18 19>;
    };

    appw_swap: app_win_swapper {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LGUI>, <&kp GRAVE>, <&kt LGUI>;

        ignored-key-positions = <22 16 17 18 19>;
    };

    combos {
        compatible = "zmk,combos";

        c_esc {
            timeout-ms = <HCMB_MS>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_lbkt2 {
            bindings = <&kp LBKT>;
            key-positions = <2 12>;
            timeout-ms = <VCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_lpar {
            timeout-ms = <VCMB_MS>;
            key-positions = <3 13>;
            bindings = <&kp LPAR>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_rpar {
            bindings = <&kp RPAR>;
            key-positions = <6 16>;
            timeout-ms = <VCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_rbkt2 {
            bindings = <&kp RBKT>;
            key-positions = <7 17>;
            timeout-ms = <VCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_bspc {
            timeout-ms = <HCMB_MS>;
            key-positions = <6 7>;
            bindings = <&kp BSPC>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_del {
            timeout-ms = <HCMB_MS>;
            key-positions = <7 8>;
            bindings = <&kp DEL>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_f14 {
            timeout-ms = <HCMB_MS>;
            key-positions = <11 12>;
            bindings = <&kp F14>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_equal {
            timeout-ms = <HCMB_MS>;
            key-positions = <11 13>;
            bindings = <&kp EQUAL>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_minus {
            timeout-ms = <HCMB_MS>;
            key-positions = <12 13>;
            bindings = <&kp MINUS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_bslh {
            timeout-ms = <HCMB_MS>;
            key-positions = <16 18>;
            bindings = <&kp BSLH>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_sqt {
            timeout-ms = <HCMB_MS>;
            key-positions = <16 17>;
            bindings = <&kp SQT>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_f15 {
            timeout-ms = <HCMB_MS>;
            key-positions = <17 18>;
            bindings = <&kp F15>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_grave {
            timeout-ms = <HCMB_MS>;
            key-positions = <21 22>;
            bindings = <&kp GRAVE>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_lbkt {
            timeout-ms = <HCMB_MS>;
            key-positions = <22 23>;
            bindings = <&kp LBKT>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_rbkt {
            timeout-ms = <HCMB_MS>;
            key-positions = <26 27>;
            bindings = <&kp RBKT>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_tab {
            timeout-ms = <HCMB_MS>;
            key-positions = <27 28>;
            bindings = <&kp TAB>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_lgame {
            timeout-ms = <HCMB_MS>;
            key-positions = <20 24>;
            bindings = <&tog 5>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_rgame {
            timeout-ms = <HCMB_MS>;
            key-positions = <25 29>;
            bindings = <&tog 5>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_lhyper {
            bindings = <&sk LA(LC(LS(LGUI)))>;
            key-positions = <14 12>;
            timeout-ms = <HCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_rhyper {
            bindings = <&sk RS(RC(RA(RGUI)))>;
            key-positions = <15 17>;
            timeout-ms = <HCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_cut {
            bindings = <&kp LG(X)>;
            key-positions = <11 21>;
            timeout-ms = <VCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_copy {
            bindings = <&kp LG(C)>;
            key-positions = <12 22>;
            timeout-ms = <VCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_paste {
            bindings = <&kp LG(V)>;
            key-positions = <13 23>;
            timeout-ms = <VCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_undo {
            bindings = <&kp LG(Z)>;
            key-positions = <14 24>;
            timeout-ms = <VCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_redo {
            bindings = <&kp LG(LS(Z))>;
            key-positions = <15 25>;
            timeout-ms = <VCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_f14e {
            bindings = <&kp F14>;
            key-positions = <16 26>;
            timeout-ms = <VCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };

        c_f15e {
            bindings = <&kp F15>;
            key-positions = <17 27>;
            timeout-ms = <VCMB_MS>;
            require-prior-idle-ms = <RPI_MS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q         &kp W         &kp E          &kp R          &kp T                              &kp Y      &kp U          &kp I          &kp O         &kp P
&lpht LGUI A  &lpht LALT S  &lpht LCTRL D  &lpht LSHFT F  &kp G                              &kp H      &rpht RSHFT J  &rpht RCTRL K  &rpht RALT L  &rpht RGUI SEMI
&kp Z         &kp X         &kp C          &kp V          &kp B                              &kp N      &kp M          &kp COMMA      &kp DOT       &kp FSLH
                                                          &lt 2 SPACE  &lt 3 ENTER    &sl 1  &mshft
            >;
        };

        num {
            bindings = <
&trans         &kp N7             &kp N8          &kp N9          &trans                    &kp KP_NUMLOCK  &trans       &kp CARET     &trans           &kp ENTER
&lpht LCMD N0  &lpht LEFT_ALT N4  &lpht LCTRL N5  &lpht LSHFT N6  &trans                    &kp KP_EQUAL    &kp KP_PLUS  &kp KP_MINUS  &kp KP_MULTIPLY  &kp KP_DIVIDE
&trans         &kp N1             &kp N2          &kp N3          &trans                    &trans          &kp LPAR     &kp RPAR      &kp KP_DOT       &kp KP_COMMA
                                                                  &trans  &trans    &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans    &trans    &kp LS(TAB)    &app_swap   &trans                    &kp CAPS      &kp BSPC          &kp UP            &kp DEL           &kp ENTER
&sk LGUI  &sk LALT  &sk LCTRL      &sk LSHFT   &trans                    &kp HOME      &rpht RSHFT LEFT  &rpht RCTRL DOWN  &rpht RALT RIGHT  &rpht RGUI END
&trans    &trans    &kp LS(GRAVE)  &appw_swap  &trans                    &caps_word    &kp PG_UP         &kp TAB           &kp PG_DN         &kp K_APP
                                               &trans  &trans    &trans  &kp K_CANCEL
            >;
        };

        fun {
            bindings = <
&kp F15           &kp F7         &kp F8          &kp F9          &kp F10                    &kp PAUSE_BREAK  &kp C_BRI_UP        &kp C_VOL_UP          &kp C_BRI_DN       &trans
&lpht LGUI PSCRN  &lpht LALT F4  &lpht LCTRL F5  &lpht LSHFT F6  &kp F11                    &kp INS          &rpht RSHFT C_PREV  &rpht RCTRL C_VOL_DN  &rpht RALT C_NEXT  &rpht RGUI PSCRN
&kp F14           &kp F1         &kp F2          &kp F3          &kp F12                    &key_repeat      &kp C_STOP          &kp C_MUTE            &kp C_PP           &trans
                                                                 &trans   &trans    &trans  &trans
            >;
        };

        ble {
            bindings = <
&bootloader     &sys_reset  &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1                    &bt BT_SEL 1  &bt BT_SEL 0  &out OUT_BLE  &sys_reset  &bootloader
&trans          &bt BT_CLR  &out OUT_TOG  &trans        &bt BT_SEL 2                    &bt BT_SEL 2  &trans        &out OUT_TOG  &bt BT_CLR  &trans
&bt BT_CLR_ALL  &trans      &out OUT_USB  &bt BT_SEL 4  &bt BT_SEL 3                    &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_USB  &trans      &bt BT_CLR_ALL
                                                        &trans        &trans    &trans  &trans
            >;
        };

        game {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T                               &kp Y     &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F  &kp G                               &kp H     &kp J  &kp K      &kp L    &kp SEMI
&kp Z  &kp X  &kp C  &kp V  &kp B                               &kp N     &kp M  &kp COMMA  &kp DOT  &kp FSLH
                            &kp SPACE  &kp ENTER    &kp ESCAPE  &kp BSPC
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        to_ble {
            if-layers = <3 1>;
            then-layer = <4>;
        };
    };
};
